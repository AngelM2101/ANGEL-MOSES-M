import sqlite3
import tkinter as tk
from tkinter import messagebox, ttk


def initialize_db():
    conn = sqlite3.connect("hardware_store.db")
    cursor = conn.cursor()
    cursor.execute('''CREATE TABLE IF NOT EXISTS inventory (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        name TEXT,
                        category TEXT,
                        price REAL,
                        quantity INTEGER,
                        supplier TEXT)''')
    conn.commit()
    conn.close()


def add_item():
    name = name_var.get()
    category = category_var.get()
    price = float(price_var.get())
    quantity = int(quantity_var.get())
    supplier = supplier_var.get()
    
    conn = sqlite3.connect("hardware_store.db")
    cursor = conn.cursor()
    cursor.execute("INSERT INTO inventory (name, category, price, quantity, supplier) VALUES (?, ?, ?, ?, ?)",
                   (name, category, price, quantity, supplier))
    conn.commit()
    conn.close()
    messagebox.showinfo("Success", "Item added successfully!")
    view_inventory()

def view_inventory():
    conn = sqlite3.connect("hardware_store.db")
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM inventory")
    rows = cursor.fetchall()
    conn.close()
    
    inventory_list.delete(*inventory_list.get_children())
    for row in rows:
        inventory_list.insert("", tk.END, values=row)

# GUI Setup
root = tk.Tk()
root.title("Hardware Store Management System")
root.geometry("700x500")

# Input Fields
name_var = tk.StringVar()
category_var = tk.StringVar()
price_var = tk.StringVar()
quantity_var = tk.StringVar()
supplier_var = tk.StringVar()

tk.Label(root, text="Name").grid(row=0, column=0)
tk.Entry(root, textvariable=name_var).grid(row=0, column=1)

tk.Label(root, text="Category").grid(row=1, column=0)
tk.Entry(root, textvariable=category_var).grid(row=1, column=1)

tk.Label(root, text="Price").grid(row=2, column=0)
tk.Entry(root, textvariable=price_var).grid(row=2, column=1)

tk.Label(root, text="Quantity").grid(row=3, column=0)
tk.Entry(root, textvariable=quantity_var).grid(row=3, column=1)

tk.Label(root, text="Supplier").grid(row=4, column=0)
tk.Entry(root, textvariable=supplier_var).grid(row=4, column=1)

# Buttons
tk.Button(root, text="Add Item", command=add_item).grid(row=5, column=0, columnspan=2)
tk.Button(root, text="View Inventory", command=view_inventory).grid(row=6, column=0, columnspan=2)

# Inventory List
columns = ("ID", "Name", "Category", "Price", "Quantity", "Supplier")
inventory_list = ttk.Treeview(root, columns=columns, show="headings")
for col in columns:
    inventory_list.heading(col, text=col)
    inventory_list.column(col, width=100)
inventory_list.grid(row=7, column=0, columnspan=2)

# Initialize Database
initialize_db()
view_inventory()

# Run Application
root.mainloop()
